# Cloudflare Pages
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# PyPI
PYPI_API_TOKEN=pypi-your_token_here

# NPM (@simtest-js org)
NPM_TOKEN=npm_your_token_here

# crates.io
CARGO_REGISTRY_TOKEN=your_crates_io_token

# GitHub PAT (repo + workflow scopes, used by semantic-release)
GH_TOKEN=github_pat_your_token_here
