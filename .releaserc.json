{
  "branches": [
    "main",
    { "name": "beta", "prerelease": true }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    ["@semantic-release/exec", {
      "prepareCmd": "sed -i 's/^version = .*/version = \"${nextRelease.version}\"/' Cargo.toml && sed -i 's/^version = .*/version = \"${nextRelease.version}\"/' crates/simtest-funnel-python/pyproject.toml",
      "successCmd": "echo '${nextRelease.version}' > .release-version"
    }],
    ["@semantic-release/git", {
      "assets": [
        "Cargo.toml",
        "crates/simtest-funnel-python/pyproject.toml",
        "packages/sdk/package.json",
        "CHANGELOG.md"
      ],
      "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
    }],
    "@semantic-release/github",
    ["@semantic-release/npm", { "pkgRoot": "packages/sdk" }]
  ]
}
